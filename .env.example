# Copy to .env and fill in. .env is gitignored — never commit a real token.
#
# Your Okta org URL, no trailing slash.
#   Developer Edition looks like: https://dev-12345678.okta.com
OKTA_ORG_URL=https://dev-00000000.okta.com

# API token created at: Admin console -> Security -> API -> Tokens -> Create Token
# Shown exactly once. Starts with "00".
#
# NOTE: Okta API tokens are valid for 30 days from creation OR last use — the
# clock resets on every call. A token used by a nightly job never expires. That
# behaviour is itself one of the findings this tool reports on.
OKTA_API_TOKEN=

# Optional. Service-account detection is a heuristic score from 0.0 to 1.0.
# Lower = more sensitive = more false positives. See docs/false-positives.md.
NHI_SERVICE_ACCOUNT_THRESHOLD=0.5
